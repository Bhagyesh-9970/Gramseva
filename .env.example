# Smart Water, Stronger Villages — Environment Variables
PROJECT_NAME="Smart Water, Stronger Villages"
TAGLINE="Smart Monitoring. Faster Maintenance. Reliable Water. Transparent Distribution."

# Database: Uses SQLite for instant local zero-setup; or PostgreSQL in production/Docker
DATABASE_URL=sqlite:///./smart_water_pds.db
# DATABASE_URL=postgresql://smartwater:smartwater_pass_2026@localhost:5432/smartwater_pds

# Security Secret
SECRET_KEY=smart-water-pds-super-secret-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# IoT Telemetry & MQTT Broker
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_BASE_TOPIC=smartpanchayat/v1
SIMULATION_MODE=true

# Frontend Port
VITE_API_BASE_URL=http://localhost:8000
